{
    "name": "math-editor",
    "version": "1.0.0",
    "author": "Mirko Vanzetto",
    "companyName": "Mirko Vanzetto",
    "description": "Editor matematico avanzato",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "rebuild": "electron-rebuild -f -w canvas",
        "dist": "electron-builder --publish=never",
        "postinstall": "electron-builder install-app-deps"
      
    },
    "build": {
      "appId": "com.yourname.matheditor",
      "productName": "Math Editor Pro",
      "directories": {
        "output": "dist"
      },
      "files": [
        "**/*",
        "!dist",
        "!node_modules/.bin",
        "node_modules/pdfkit/**/*"

      ],
      "asar": true,
      "extraResources": [
        {
          "from": "fonts",
          "to": "fonts",
          "filter": ["**/*"]
        },
        {
          "from": "assets",
          "to": "assets",
          "filter": ["**/*"]
        }
      ],
      "win": {
        "target": "nsis",
        "icon": "assets/icons/icon.ico"
      },
      "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true
      }
    },
    "devDependencies": {
      "electron": "^28.0.0",
      "electron-builder": "^24.9.1",
      "electron-rebuild": "^3.2.5"
    },
    "dependencies": {
      "@fontsource/dejavu-sans": "^5.2.5",
      "canvas": "^3.2.0",
      "pdfkit": "^0.17.2"
    }
  }